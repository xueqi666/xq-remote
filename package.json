{
  "name": "xq-remote",
  "version": "1.2.1",
  "description": "A simple Node.js tool for deploying local files to a remote server via SSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueqi666/xq-remote.git"
  },
  "bugs": {
    "url": "https://github.com/xueqi666/xq-remote/issues"
  },
  "homepage": "https://github.com/xueqi666/xq-remote#readme",
  "main": "remote.js",
  "bin": {
    "xq-remote": "remote.js",
    "xq-remote-encrypt": "encrypt.js",
    "xq-remote-decrypt": "decrypt.js"
  },
  "keywords": [
    "ssh",
    "deploy",
    "deployment",
    "automation"
  ],
  "author": "xueqi666",
  "license": "MIT",
  "scripts": {
    "encrypt": "node encrypt.js",
    "decrypt": "node decrypt.js",
    "remote": "cross-env NODE_ENV=remote node remote.js"
  },
  "dependencies": {
    "config": "^3.3.11",
    "cross-env": "^7.0.3",
    "ssh2": "^1.15.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
